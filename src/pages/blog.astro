---
import Base from '../layouts/Base.astro';
import BlogList from '../components/BlogList.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../config';
---

<Base title={`${SITE_TITLE} - Blog`} description={SITE_DESCRIPTION}>
    <section>
        <h1>Blog</h1>
        <p class="intro">Long-form posts on code, systems, and ideas.</p>
        <BlogList />
    </section>
</Base>

<style>
    h1 {
        margin: 0 0 var(--lucid-space-2);
    }
    .intro {
        color: var(--lucid-color-fg-body);
        margin: 0 0 var(--lucid-space-6);
    }
</style>

---
// GTA 6 Relationship Agreement Contract.
// Standalone full-viewport page (no site header/footer), gated by an access code.
const title = 'Grand Theft Auto VI — Relationship Agreement Contract';
---

<!DOCTYPE html>
<html lang="en-us">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="theme-color" content="#120a1f" />
    <link rel="icon" type="image/png" href="/gta6/logo.png" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Anton&family=EB+Garamond:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@400;500;600;700&family=Mrs+Saint+Delafield&display=swap"
    />
</head>
<body>
    <!-- ───────────── Access gate ───────────── -->
    <div id="gate" class="gate">
        <img class="gate-bg" src="/gta6/cover.jpg" alt="" aria-hidden="true" />
        <form id="gate-form" class="gate-card" autocomplete="off">
            <img class="gate-logo" src="/gta6/logo.png" alt="Grand Theft Auto VI" />
            <p class="gate-kicker">Restricted document</p>
            <label for="gate-code" class="gate-label">Enter the cheat code</label>
            <input
                id="gate-code"
                class="gate-input"
                type="password"
                inputmode="text"
                autocapitalize="characters"
                spellcheck="false"
                placeholder="••••••••"
                required
            />
            <button class="btn btn-primary" type="submit">Unlock</button>
            <p id="gate-msg" class="gate-msg" role="status" aria-live="polite"></p>
        </form>
    </div>

    <!-- ───────────── Contract app ───────────── -->
    <div id="app" class="app" hidden>
        <header class="cover">
            <img src="/gta6/cover.jpg" alt="Jason and Lucia" />
            <div id="period-chip" class="period-chip"></div>
        </header>

        <main id="scroller" class="scroller">
            <article class="paper">
                <div class="paper-head">
                    <img class="logo" src="/gta6/logo.png" alt="GTA VI logo" />
                    <h1>Grand Theft Auto 6</h1>
                    <p class="subtitle">Relationship Agreement Contract</p>
                    <p class="ref">Ref. No. GTA6-RAC-2026/11 &middot; Executed electronically</p>
                </div>

                <p class="lead">
                    This Relationship Agreement Contract (the <strong>&ldquo;Agreement&rdquo;</strong>) is
                    entered into on the Effective Date (as defined below) by and between the individual
                    executing this Agreement as <strong>the Player</strong> and the individual executing
                    this Agreement as <strong>the Partner</strong> (each a <strong>&ldquo;Party&rdquo;</strong>
                    and together the <strong>&ldquo;Parties&rdquo;</strong>).
                </p>

                <h2>Recitals</h2>
                <p><span class="sc">Whereas</span>, Rockstar Games has announced the release of the video game
                    <em>Grand Theft Auto VI</em>;</p>
                <p><span class="sc">Whereas</span>, the Player has awaited said release for a period the Parties
                    agree was unreasonably long;</p>
                <p><span class="sc">Whereas</span>, the Parties wish to preserve the harmony of their relationship
                    while accommodating the Player&rsquo;s gameplay;</p>
                <p><span class="sc">Now, therefore</span>, in consideration of the mutual affection, patience and
                    snacks exchanged between them, the Parties agree as follows:</p>

                <h2 class="art">Article 1 &mdash; Definitions</h2>
                <ol class="clauses">
                    <li><strong>&ldquo;Game&rdquo;</strong> means <em>Grand Theft Auto VI</em>, published by
                        Rockstar Games, including all of its modes, content and updates.</li>
                    <li><strong>&ldquo;Release Date&rdquo;</strong> means the date on which the Game is first
                        made generally available by Rockstar Games to the public.</li>
                    <li><strong>&ldquo;Gaming Period&rdquo;</strong> has the meaning given in Clause 2.1, as
                        adjusted under Clause 2.2.</li>
                    <li><strong>&ldquo;Natural Stopping Point&rdquo;</strong> means the completion, failure or
                        saving of the mission, task, activity, cut-scene or other unit of gameplay that the
                        Player is engaged in at the time a request is made.</li>
                    <li><strong>&ldquo;Emotional Support&rdquo;</strong> means hugs, kisses, conversation,
                        reassurance, words of encouragement and any other comforting act reasonably requested
                        by a Party.</li>
                    <li><strong>&ldquo;Emergency&rdquo;</strong> means a matter that satisfies both limbs of the
                        test in Clause 4.2.</li>
                </ol>

                <h2 class="art">Article 2 &mdash; Grant of Gaming Period</h2>
                <ol class="clauses">
                    <li>The Partner hereby grants the Player permission to play the Game from
                        <strong>19 November 2026</strong> to <strong>29 November 2026</strong>, both days
                        inclusive (the <strong>&ldquo;Gaming Period&rdquo;</strong>), being a duration of
                        eleven (11) consecutive calendar days.</li>
                    <li>Should Rockstar Games alter the Release Date, the Gaming Period shall commence on the
                        revised Release Date and continue for the same duration of eleven (11) consecutive
                        calendar days. No such alteration shall reduce, shorten or otherwise diminish the
                        duration of the Gaming Period.</li>
                </ol>

                <h2 class="art">Article 3 &mdash; Emotional Support During the Gaming Period</h2>
                <ol class="clauses">
                    <li>During the Gaming Period, the Partner may request Emotional Support from the Player,
                        including without limitation hugs, kisses and conversation.</li>
                    <li>Any such request shall be fulfilled at the Player&rsquo;s convenience. The Player shall
                        not be obliged to fulfil any request immediately, and a delay in fulfilment shall not
                        constitute a breach of this Agreement.</li>
                </ol>

                <h2 class="art">Article 4 &mdash; Interruptions of Gameplay</h2>
                <ol class="clauses">
                    <li>Where the Partner wishes to hold a conversation that is not disruptive to the
                        Partner&rsquo;s well-being in any way, the Partner shall allow the Player sufficient
                        time to reach a Natural Stopping Point and close the Game before engaging with the
                        Partner.</li>
                    <li>The Partner shall be entitled to request an immediate interruption of gameplay only for
                        an Emergency, being a matter that (a) the Partner finds plausible; <em>and</em> (b) the
                        Partner has significant reasons to believe the Player will also find plausible.</li>
                    <li>A matter that satisfies only one limb of Clause 4.2 shall not constitute an Emergency.</li>
                </ol>

                <h2 class="art">Article 5 &mdash; Fictional Nature of the Game</h2>
                <ol class="clauses">
                    <li>The Partner acknowledges and understands that the Game is a game and that everything
                        occurring within it is fictional, including but not limited to:
                        <ol class="sub" type="a">
                            <li>dating, flirting or entering into romantic relationships with in-game characters;</li>
                            <li>visiting in-game clubs, bars or other establishments; and</li>
                            <li>endangering, harming or otherwise inconveniencing the Player&rsquo;s playable
                                character(s) or any non-playable character, whether through direct or indirect
                                actions.</li>
                        </ol>
                    </li>
                    <li>No act or omission within the Game shall be construed as reflecting the Player&rsquo;s
                        real-world intentions or character, nor be raised as grounds for grievance between the
                        Parties.</li>
                </ol>

                <h2 class="art">Article 6 &mdash; Emotional Support for In-Game Setbacks</h2>
                <ol class="clauses">
                    <li>Upon the Player&rsquo;s request, the Partner agrees to provide Emotional Support to the
                        Player where the Player loses a mission, fails a task, or faces any other inconvenience
                        that negatively affects the Player&rsquo;s emotional state.</li>
                    <li>Such Emotional Support shall be provided as soon as is practicable for the Partner.</li>
                </ol>

                <h2 class="art">Article 7 &mdash; General Provisions</h2>
                <ol class="clauses">
                    <li><strong>Effective Date.</strong> This Agreement takes effect on the date on which it has
                        been signed by both Parties (the <strong>&ldquo;Effective Date&rdquo;</strong>) and
                        remains in force until the end of the Gaming Period.</li>
                    <li><strong>Irrevocability.</strong> A signature once applied to this Agreement is final and
                        may not be withdrawn, revoked or erased.</li>
                    <li><strong>Electronic Execution.</strong> The Parties consent to execute this Agreement
                        electronically and may sign at different times and on different devices.</li>
                    <li><strong>Severability.</strong> If any provision of this Agreement is found
                        unenforceable, the remaining provisions shall continue in full force and effect.</li>
                    <li><strong>Entire Agreement.</strong> This Agreement constitutes the entire understanding
                        between the Parties regarding the Game and supersedes all prior sighs, eye-rolls and
                        negotiations.</li>
                    <li><strong>Governing Law.</strong> This Agreement is governed by the laws of the State of
                        Leonida.</li>
                    <li><strong>Good Faith.</strong> The Parties enter into this Agreement in a spirit of love and
                        good humour and shall interpret it accordingly.</li>
                </ol>

                <p class="witness"><span class="sc">In witness whereof</span>, the Parties have executed this
                    Agreement electronically on the dates set out below.</p>

                <section class="sig-grid" aria-label="Signatures">
                    <div class="sig" id="sig-player">
                        <div class="sig-line"><span class="sig-ink"></span></div>
                        <div class="sig-meta">
                            <span class="sig-role">The Player</span>
                            <span class="sig-name">Awaiting signature</span>
                            <span class="sig-date"></span>
                        </div>
                    </div>
                    <div class="sig" id="sig-partner">
                        <div class="sig-line"><span class="sig-ink"></span></div>
                        <div class="sig-meta">
                            <span class="sig-role">The Partner</span>
                            <span class="sig-name">Awaiting signature</span>
                            <span class="sig-date"></span>
                        </div>
                    </div>
                </section>
                <p id="print-note" class="print-note" hidden></p>
                <div id="end-sentinel" class="end-sentinel" aria-hidden="true"></div>
            </article>
        </main>

        <footer class="actions" id="actions">
            <div id="action-loading" class="action-row muted">Loading signatures…</div>

            <form id="sign-form" class="sign-form" hidden>
                <div class="role-toggle" role="radiogroup" aria-label="Signing as">
                    <button type="button" class="role" data-role="player" role="radio">The Player</button>
                    <button type="button" class="role" data-role="partner" role="radio">The Partner</button>
                </div>
                <input id="sign-name" class="name-input" type="text" placeholder="Your full name"
                    maxlength="60" autocomplete="name" required />
                <label class="agree" id="agree-label">
                    <input type="checkbox" id="agree" disabled />
                    <span id="agree-text">Scroll to the end of the contract to agree</span>
                </label>
                <button id="sign-btn" class="btn btn-primary" type="submit" disabled>Sign</button>
                <p id="sign-msg" class="sign-msg" role="status" aria-live="polite"></p>
            </form>

            <div id="confirm" class="confirm" hidden>
                <div class="confirm-title" id="confirm-title"></div>
                <div class="confirm-body" id="confirm-body"></div>
                <button id="confirm-other" class="link-btn" type="button" hidden></button>
                <button id="print-btn" class="btn btn-primary print-btn" type="button" hidden>Print / Save as PDF</button>
            </div>
        </footer>

        <div id="passed" class="passed" aria-hidden="true">
            <div class="passed-title">Mission Passed</div>
            <div class="passed-sub">Respect +</div>
        </div>
    </div>

    <script>
        // ─── Config ────────────────────────────────────────────────
        // Firebase Realtime Database. Its security rules make each signature write-once:
        // gta6/<key>/<player|partner> can be created but never overwritten or deleted.
        const DB_URL = 'https://gta6-msagnik-default-rtdb.asia-southeast1.firebasedatabase.app';
        const KV_KEY = 'signature'; // use 'signature-dev' for local testing
        const RECORD_URL = `${DB_URL}/gta6/${KV_KEY}`;
        // SHA-256 of the normalised access code (uppercase, letters/digits only).
        const CODE_HASH = 'bded351d2e0641a3f52ace8f95a67144f315234e74ae2e9e80db55e4f98523b9';
        const UNLOCK_KEY = 'gta6-unlocked';
        const MINE_KEY = `gta6-signed-as:${KV_KEY}`;
        const PERIOD_START = new Date(2026, 10, 19); // local midnight, 19 Nov
        const PERIOD_DAYS = 11;

        type Role = 'player' | 'partner';
        type Signature = { name: string; signedAt: string };
        type Record_ = Partial<Record<Role, Signature>>;
        const ROLES: Role[] = ['player', 'partner'];
        const LABEL: Record<Role, string> = { player: 'The Player', partner: 'The Partner' };

        const $ = <T extends HTMLElement = HTMLElement>(sel: string) => document.querySelector(sel) as T;
        const store = {
            get(k: string) { try { return localStorage.getItem(k); } catch { return null; } },
            set(k: string, v: string) { try { localStorage.setItem(k, v); } catch { /* ignore */ } },
        };

        // ─── Gate ──────────────────────────────────────────────────
        async function sha256(text: string) {
            const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(text));
            return [...new Uint8Array(buf)].map((b) => b.toString(16).padStart(2, '0')).join('');
        }
        const normalise = (s: string) => s.toUpperCase().replace(/[^A-Z0-9]/g, '');

        const gate = $('#gate');
        const gateForm = $<HTMLFormElement>('#gate-form');
        const gateMsg = $('#gate-msg');

        gateForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const input = $<HTMLInputElement>('#gate-code');
            if ((await sha256(normalise(input.value))) === CODE_HASH) {
                store.set(UNLOCK_KEY, CODE_HASH);
                gateMsg.textContent = 'Cheat activated';
                gateMsg.className = 'gate-msg ok';
                setTimeout(unlock, 500);
            } else {
                gateMsg.textContent = 'Wasted';
                gateMsg.className = 'gate-msg bad';
                gateForm.classList.remove('shake');
                void gateForm.offsetWidth;
                gateForm.classList.add('shake');
                input.select();
            }
        });

        function unlock() {
            gate.remove();
            $('#app').hidden = false;
            renderPeriod();
            watchScroll();
            load();
        }

        if (store.get(UNLOCK_KEY) === CODE_HASH) unlock();
        else $<HTMLInputElement>('#gate-code').focus();

        // ─── Gaming-period chip ────────────────────────────────────
        function renderPeriod() {
            const chip = $('#period-chip');
            const now = new Date();
            const end = new Date(PERIOD_START);
            end.setDate(end.getDate() + PERIOD_DAYS);
            const dayMs = 86400000;
            if (now < PERIOD_START) {
                const ms = PERIOD_START.getTime() - now.getTime();
                const d = Math.floor(ms / dayMs);
                const h = Math.floor((ms % dayMs) / 3600000);
                chip.textContent = `Gaming Period begins in ${d}d ${h}h`;
            } else if (now < end) {
                const day = Math.floor((now.getTime() - PERIOD_START.getTime()) / dayMs) + 1;
                chip.textContent = `Gaming Period · Day ${day} of ${PERIOD_DAYS}`;
                chip.classList.add('live');
            } else {
                chip.textContent = 'Gaming Period concluded';
            }
        }

        // ─── Scroll-to-agree ───────────────────────────────────────
        let readToEnd = false;
        function watchScroll() {
            const io = new IntersectionObserver((entries) => {
                if (entries.some((en) => en.isIntersecting)) {
                    readToEnd = true;
                    $<HTMLInputElement>('#agree').disabled = false;
                    $('#agree-text').textContent = 'I have read and agree to the terms of this Agreement';
                    $('#agree-label').classList.add('ready');
                    io.disconnect();
                }
            }, { root: $('#scroller') });
            io.observe($('#end-sentinel'));
        }

        // ─── Signature registry (Firebase REST) ────────────────────
        class AlreadySigned extends Error {}

        async function fetchRecord(): Promise<Record_> {
            const res = await fetch(`${RECORD_URL}.json`, { cache: 'no-store' });
            if (!res.ok) throw new Error(`Signature registry read failed (${res.status})`);
            const data = await res.json();
            return data && typeof data === 'object' ? data : {};
        }
        async function saveSignature(role: Role, sig: Signature) {
            const res = await fetch(`${RECORD_URL}/${role}.json`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(sig),
            });
            if (res.ok) return;
            // The rules deny any write to an existing signature, so 401 almost always
            // means the other device got there first.
            if (res.status === 401 && (await fetchRecord())[role]) throw new AlreadySigned();
            let reason = '';
            try { reason = (await res.json()).error || ''; } catch { /* ignore */ }
            throw new Error(`Signature registry refused the write (${res.status})${reason ? `: ${reason}` : ''}`);
        }

        // ─── Rendering ─────────────────────────────────────────────
        let record: Record_ = {};
        let selected: Role | null = null;
        let showFormAnyway = false;

        const fmtDate = (iso: string) =>
            new Date(iso).toLocaleString(undefined, {
                day: 'numeric', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit',
            });

        async function load() {
            try {
                record = await fetchRecord();
                render();
            } catch (err) {
                $('#action-loading').innerHTML = '';
                const p = document.createElement('span');
                p.textContent = 'Could not reach the signature registry. ';
                const b = document.createElement('button');
                b.className = 'link-btn';
                b.textContent = 'Retry';
                b.onclick = () => { $('#action-loading').textContent = 'Loading signatures…'; load(); };
                $('#action-loading').append(p, b);
            }
        }

        function render() {
            $('#action-loading').hidden = true;
            for (const role of ROLES) {
                const el = $(`#sig-${role}`);
                const sig = record[role];
                el.classList.toggle('signed', !!sig);
                el.querySelector('.sig-ink')!.textContent = sig ? sig.name : '';
                el.querySelector('.sig-name')!.textContent = sig ? sig.name : 'Awaiting signature';
                el.querySelector('.sig-date')!.textContent = sig ? `Signed ${fmtDate(sig.signedAt)}` : '';
            }
            fitSignatures();

            const unsigned = ROLES.filter((r) => !record[r]);
            const mine = store.get(MINE_KEY) as Role | null;
            const form = $<HTMLFormElement>('#sign-form');
            const confirm = $('#confirm');
            const other = $('#confirm-other');

            if (unsigned.length === 0) {
                form.hidden = true;
                confirm.hidden = false;
                other.hidden = true;
                const effective = [record.player!, record.partner!]
                    .map((s) => s.signedAt).sort().at(-1)!;
                $('#confirm-title').textContent = 'Contract executed';
                $('#confirm-body').textContent =
                    `Signed by ${record.player!.name} and ${record.partner!.name}. Effective ${fmtDate(effective)}. Irrevocable.`;
                confirm.classList.add('complete');
                $('#print-btn').hidden = false;
                const note = $('#print-note');
                note.hidden = false;
                note.textContent =
                    `Executed electronically by both Parties. Effective Date: ${fmtDate(effective)}. ` +
                    `Signatures are final and irrevocable (Clause 7.2). Record: ${location.host}${location.pathname}`;
                return;
            }

            if (mine && record[mine] && !showFormAnyway) {
                form.hidden = true;
                confirm.hidden = false;
                const waiting = unsigned[0];
                $('#confirm-title').textContent = `Signed as ${LABEL[mine]}`;
                $('#confirm-body').textContent =
                    `${record[mine]!.name}, ${fmtDate(record[mine]!.signedAt)}. Awaiting ${LABEL[waiting]}.`;
                other.hidden = false;
                other.textContent = `${LABEL[waiting]} signing on this device?`;
                return;
            }

            confirm.hidden = true;
            form.hidden = false;
            if (!selected || record[selected]) selected = unsigned.length === 1 ? unsigned[0] : null;
            document.querySelectorAll<HTMLButtonElement>('.role').forEach((btn) => {
                const role = btn.dataset.role as Role;
                const signed = !!record[role];
                btn.disabled = signed;
                btn.textContent = signed ? `${LABEL[role]} ✓` : LABEL[role];
                btn.setAttribute('aria-checked', String(selected === role));
                btn.classList.toggle('active', selected === role);
            });
            updateSignBtn();
        }

        // ─── Name verification ─────────────────────────────────────
        // Accepted names per role, stored only as SHA-256("gta6:<role>:<name>") where
        // <name> is lowercased with all whitespace removed.
        const NAME_HASHES: Record<Role, string[]> = {
            player: [
                '025efd46c3fc2492e1e0f095759ce9a8382a94fec943beb50d62a7c1ee729ce3',
                '989ae98a54fe613a035c6a75bf91fc52a0fd05cfe7219cdf323da83788275e2c',
            ],
            partner: [
                '24934edb9cf5926fb2c16b2cdc8f59d6a4d0dea1357f232139f58d3430141a3e',
                'b2bdb3888e9a4a5abf07b843ca362dee844c29ed87f9dbab7c99759acf5b9963',
                '6a4757336798b7649fe01572c27fb140f3ee5bcec5c33d4d080ca62a6315a686',
            ],
        };
        const cleanName = (s: string) => s.trim().replace(/\s+/g, ' ');
        let nameOk = false;

        async function validateName() {
            const input = $<HTMLInputElement>('#sign-name');
            const value = input.value;
            const role = selected;
            let ok = false;
            if (role && value.trim()) {
                const key = value.toLowerCase().replace(/\s+/g, '');
                ok = NAME_HASHES[role].includes(await sha256(`gta6:${role}:${key}`));
            }
            // Ignore stale results if the user kept typing or switched role meanwhile.
            if (input.value !== value || selected !== role) return;
            nameOk = ok;
            input.classList.toggle('valid', ok);
            updateSignBtn();
        }

        function showNameHint() {
            const value = $<HTMLInputElement>('#sign-name').value.trim();
            const invalid = !!value && !nameOk && !!selected;
            $('#sign-name').classList.toggle('invalid', invalid);
            $('#sign-msg').textContent = invalid ? `That name isn’t on this contract for ${LABEL[selected!]}.` : '';
        }

        // Shrink each handwritten signature until it fits on its line.
        function fitSignatures() {
            document.querySelectorAll<HTMLElement>('.sig-ink').forEach((ink) => {
                ink.style.fontSize = '';
                const line = ink.parentElement!;
                let size = parseFloat(getComputedStyle(ink).fontSize);
                const min = 16;
                while (ink.scrollWidth > line.clientWidth && size > min) {
                    size = Math.max(min, size - 1);
                    ink.style.fontSize = `${size}px`;
                }
            });
        }
        window.addEventListener('resize', fitSignatures);
        document.fonts?.ready.then(fitSignatures);

        function updateSignBtn() {
            const agreed = $<HTMLInputElement>('#agree').checked;
            $<HTMLButtonElement>('#sign-btn').disabled = !(selected && nameOk && agreed && readToEnd);
            $<HTMLButtonElement>('#sign-btn').textContent = selected ? `Sign as ${LABEL[selected]}` : 'Choose your role';
        }

        document.querySelectorAll<HTMLButtonElement>('.role').forEach((btn) =>
            btn.addEventListener('click', async () => {
                selected = btn.dataset.role as Role;
                render();
                await validateName();
                showNameHint();
            }));
        $('#sign-name').addEventListener('input', async () => {
            nameOk = false;
            updateSignBtn();
            await validateName();
            // Clear the error as soon as it becomes valid; only nag again on blur.
            if (nameOk) showNameHint();
        });
        $('#sign-name').addEventListener('blur', () => validateName().then(showNameHint));
        $('#agree').addEventListener('change', updateSignBtn);
        $('#confirm-other').addEventListener('click', () => { showFormAnyway = true; render(); });
        $('#print-btn').addEventListener('click', () => window.print());

        $<HTMLFormElement>('#sign-form').addEventListener('submit', async (e) => {
            e.preventDefault();
            if (!selected) return;
            const role = selected;
            const btn = $<HTMLButtonElement>('#sign-btn');
            const msg = $('#sign-msg');
            btn.disabled = true;
            btn.textContent = 'Signing…';
            msg.textContent = '';
            try {
                const sig: Signature = {
                    name: cleanName($<HTMLInputElement>('#sign-name').value),
                    signedAt: new Date().toISOString(),
                };
                // Write-once per role is enforced server-side by the database rules.
                await saveSignature(role, sig);
                record = await fetchRecord().catch(() => ({ ...record, [role]: sig }));
                store.set(MINE_KEY, role);
                showFormAnyway = false;
                $<HTMLInputElement>('#sign-name').value = '';
                $('#sign-name').classList.remove('valid', 'invalid');
                nameOk = false;
                $<HTMLInputElement>('#agree').checked = false;
                render();
                missionPassed();
            } catch (err) {
                if (err instanceof AlreadySigned) {
                    record = await fetchRecord().catch(() => record);
                    msg.textContent = `${LABEL[role]} has already signed. Signatures cannot be changed.`;
                    render();
                    return;
                }
                msg.textContent = err instanceof TypeError
                    ? 'Signing failed — check your connection and try again.'
                    : `Signing failed — ${(err as Error).message}`;
                updateSignBtn();
            }
        });

        function missionPassed() {
            const el = $('#passed');
            el.classList.remove('show');
            void el.offsetWidth;
            el.classList.add('show');
            const s = $('#scroller');
            s.scrollTo({ top: s.scrollHeight, behavior: 'smooth' });
        }
    </script>
</body>

---
import Base from './Base.astro';

export interface Props {
    content: {
        title: string;
        description: string;
        created?: string;
        updated?: string;
        heroImage?: string;
    };
}

const {
    content: { title, description, created, updated, heroImage },
} = Astro.props as Props;
---

<Base title={title} description={description} image={heroImage} katex>
    <article>
        {heroImage && (
            <img class="hero" width={720} height={360} src={heroImage} alt="" />
        )}
        <h1 class="title">{title}</h1>
        {created && (
            <time class="posted" datetime={created}>
                {new Date(created).toLocaleDateString('en-us', {
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric',
                })}
            </time>
        )}
        {updated && (
            <div class="updated">Last updated on <time>{updated}</time></div>
        )}
        <hr />
        <slot />
    </article>
</Base>

<style>
    .title {
        font-size: 2em;
        margin: 0.25em 0 0;
    }
    .hero {
        width: 100%;
        height: auto;
        border-radius: var(--lucid-radius-md);
    }
    .posted,
    .updated {
        color: var(--lucid-color-muted);
        font-size: var(--lucid-font-size-sm);
    }
    hr {
        border: 0;
        border-top: 1px solid var(--lucid-color-border);
        margin: var(--lucid-space-4) 0;
    }
    article {
        text-align: justify;
    }
</style>

<style is:global>
    .toc {
        display: none;
    }
</style>

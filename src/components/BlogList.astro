---
export interface BlogListProps {
    limit?: number;
}

const { limit = -1 } = Astro.props as BlogListProps;
const allPosts = (await Astro.glob('/src/pages/blog/*.{md,mdx}')).sort(
    (a, b) =>
        new Date(b.frontmatter.created).valueOf() -
        new Date(a.frontmatter.created).valueOf()
);
const posts = limit > -1 ? allPosts.slice(0, limit) : allPosts;
---

<ul class="post-grid" role="list">
    {posts.map((post) => (
        <li>
            <a class="card-link" href={post.url}>
                <lucid-card variant="elevated">
                    <span slot="title">{post.frontmatter.title}</span>
                    <time class="meta" datetime={post.frontmatter.created}>
                        {new Date(post.frontmatter.created).toLocaleDateString('en-us', {
                            year: 'numeric',
                            month: 'short',
                            day: 'numeric',
                        })}
                    </time>
                    {post.frontmatter.description && (
                        <p class="description">{post.frontmatter.description}</p>
                    )}
                </lucid-card>
            </a>
        </li>
    ))}
</ul>

<style>
    .post-grid {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: var(--lucid-space-4);
    }
    .card-link {
        display: block;
        color: inherit;
        text-decoration: none;
        border-radius: var(--lucid-radius-md);
        transition: transform 150ms ease;
    }
    .card-link:hover,
    .card-link:focus-visible {
        transform: translateY(-2px);
    }
    .card-link:focus-visible {
        outline: var(--lucid-outline-width) solid var(--lucid-color-primary);
        outline-offset: var(--lucid-outline-offset);
    }
    .meta {
        display: block;
        color: var(--lucid-color-muted);
        font-size: var(--lucid-font-size-sm);
        margin-block: var(--lucid-space-1) var(--lucid-space-2);
    }
    .description {
        margin: 0;
        color: var(--lucid-color-fg-body);
        font-size: var(--lucid-font-size-md);
    }
</style>
